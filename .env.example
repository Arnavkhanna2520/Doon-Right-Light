# Copy to backend/.env for local use, or set these in your hosting dashboard.
# Never commit a real .env file.

DRL_ENV=development                 # use "production" when deployed
DRL_SECRET_KEY=                     # REQUIRED in production. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
DRL_DATABASE_URL=                   # empty = SQLite at backend/data/doon.db ; or postgresql://user:pass@host:5432/dbname
DRL_TRUST_PROXY=false               # true behind Render / Nginx so rate limits see the real client IP
DRL_CORS_ORIGINS=                   # only if the frontend is hosted on a different origin, comma separated

# First-run administrator (created once, only if no users exist). Change the password after signing in.
DRL_ADMIN_EMAIL=
DRL_ADMIN_PASSWORD=

DRL_REPORT_RATE_LIMIT=5             # public reports per IP per hour
DRL_MAX_PHOTO_MB=5
DRL_MAX_CSV_MB=5
DRL_UPLOAD_DIR=                     # empty = backend/data/uploads (needs a persistent disk in production)

# Optional: NASA Black Marble through Google Earth Engine (see README, "Satellite data")
DRL_GEE_SERVICE_ACCOUNT=
DRL_GEE_KEY_FILE=
